# ======================
# General
# ======================
APP_NAME=JobPulse
COMPOSE_PROJECT_NAME=jobpulse

# ======================
# Database (PostgreSQL)
# ======================
POSTGRES_DB=jobpulse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_PORT=5432

# Used by the scrapers service
DATABASE_URL=postgresql://postgres:your_strong_password_here@postgres:5432/jobpulse

# ======================
# Redis
# ======================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ======================
# Ports
# ======================
FRONTEND_PORT=5173
NGINX_PORT=8080
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# ======================
# Frontend
# ======================
VITE_API_URL=http://localhost:8080